{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corellia.dev/schema/events.schema.json",
  "title": "SessionEvent",
  "description": "Events on the server-to-client stream (SSE). Every event has `type`, a monotonically increasing `seq` used for replay, and `ts`. Turn-scoped events carry `turn_id`.",
  "oneOf": [
    {
      "$ref": "#/$defs/SessionEventSnapshot"
    },
    {
      "$ref": "#/$defs/StateEvent"
    },
    {
      "$ref": "#/$defs/TextDeltaEvent"
    },
    {
      "$ref": "#/$defs/SpecOpEvent"
    },
    {
      "$ref": "#/$defs/SpeechEvent"
    },
    {
      "$ref": "#/$defs/ProposalEvent"
    },
    {
      "$ref": "#/$defs/ToolCallEvent"
    },
    {
      "$ref": "#/$defs/ToolResultEvent"
    },
    {
      "$ref": "#/$defs/TurnStartedEvent"
    },
    {
      "$ref": "#/$defs/TurnDoneEvent"
    },
    {
      "$ref": "#/$defs/ErrorEvent"
    },
    {
      "$ref": "#/$defs/ProactiveEvent"
    },
    {
      "$ref": "#/$defs/HeartbeatEvent"
    }
  ],
  "$defs": {
    "Base": {
      "type": "object",
      "required": [
        "type",
        "seq",
        "ts"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        }
      }
    },
    "TurnId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "AgentState": {
      "description": "The 3D agent's presentation state.",
      "type": "string",
      "enum": [
        "idle",
        "listening",
        "thinking",
        "speaking",
        "error"
      ]
    },
    "Modality": {
      "description": "How the decision layer chose to surface a reply.",
      "type": "string",
      "enum": [
        "none",
        "voice",
        "glance",
        "visual",
        "both"
      ]
    },
    "SessionEventSnapshot": {
      "description": "Sent first on every (re)connect: the full current state so the client can render without replay.",
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "session_id",
        "agent_state",
        "spec",
        "pending_proposals",
        "capabilities"
      ],
      "properties": {
        "type": {
          "const": "session",
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "agent_name": {
          "type": "string"
        },
        "agent_state": {
          "$ref": "#/$defs/AgentState"
        },
        "spec": {
          "$ref": "ui-spec.schema.json"
        },
        "pending_proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Proposal"
          }
        },
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "transcript": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TranscriptEntry"
          }
        }
      }
    },
    "Capabilities": {
      "type": "object",
      "required": [
        "runtime",
        "streaming",
        "ui_ops",
        "stt",
        "tts"
      ],
      "properties": {
        "runtime": {
          "type": "string"
        },
        "streaming": {
          "type": "boolean"
        },
        "ui_ops": {
          "type": "boolean"
        },
        "tools": {
          "type": "boolean"
        },
        "cancel": {
          "type": "boolean"
        },
        "stt": {
          "type": "string",
          "description": "Server STT provider name, or `none` (client falls back to browser recognition)."
        },
        "tts": {
          "type": "string",
          "description": "Server TTS provider name, or `none` (client falls back to speechSynthesis)."
        }
      }
    },
    "TranscriptEntry": {
      "type": "object",
      "required": [
        "role",
        "text",
        "ts"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "user",
            "agent",
            "system"
          ]
        },
        "text": {
          "type": "string"
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "turn_id": {
          "$ref": "#/$defs/TurnId"
        },
        "source": {
          "type": "string",
          "enum": [
            "keyboard",
            "voice",
            "proactive",
            "action"
          ]
        }
      }
    },
    "StateEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "state"
      ],
      "properties": {
        "type": {
          "const": "state",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/AgentState"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "TurnStartedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "turn_id",
        "text",
        "source"
      ],
      "properties": {
        "type": {
          "const": "turn_started",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "keyboard",
            "voice",
            "proactive",
            "action"
          ]
        }
      }
    },
    "TextDeltaEvent": {
      "description": "A chunk of the agent's textual reply for the transcript.",
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "turn_id",
        "delta"
      ],
      "properties": {
        "type": {
          "const": "text_delta",
          "type": "string"
        },
        "delta": {
          "type": "string"
        }
      }
    },
    "SpecOpEvent": {
      "description": "A validated spec op. The client applies it with the shared reducer.",
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "op"
      ],
      "properties": {
        "type": {
          "const": "spec_op",
          "type": "string"
        },
        "op": {
          "$ref": "ops.schema.json"
        },
        "modality": {
          "$ref": "#/$defs/Modality"
        }
      }
    },
    "SpeechEvent": {
      "description": "Text the decision layer chose to say aloud, in sentence-sized pieces. `audio_url` is set when a server TTS provider rendered it; otherwise the client synthesises.",
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "speech",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "audio_url": {
          "type": "string"
        },
        "final": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "Proposal": {
      "type": "object",
      "required": [
        "id",
        "tool",
        "args",
        "label",
        "risk",
        "expires_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "label": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ProposalEvent": {
      "description": "A proposed side effect awaiting confirmation (VISION.md 5.6). `status` moves pending -> confirmed|rejected|expired.",
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "proposal",
        "status"
      ],
      "properties": {
        "type": {
          "const": "proposal",
          "type": "string"
        },
        "proposal": {
          "$ref": "#/$defs/Proposal"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "confirmed",
            "rejected",
            "expired",
            "executed",
            "failed"
          ]
        }
      }
    },
    "ToolCallEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "turn_id",
        "call_id",
        "tool",
        "args"
      ],
      "properties": {
        "type": {
          "const": "tool_call",
          "type": "string"
        },
        "call_id": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "args": {
          "type": "object"
        }
      }
    },
    "ToolResultEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "turn_id",
        "call_id",
        "tool",
        "ok"
      ],
      "properties": {
        "type": {
          "const": "tool_result",
          "type": "string"
        },
        "call_id": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "TurnDoneEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "turn_id",
        "status"
      ],
      "properties": {
        "type": {
          "const": "turn_done",
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "cancelled",
            "failed"
          ]
        },
        "text": {
          "type": "string",
          "description": "The full reply text for the transcript."
        },
        "modality": {
          "$ref": "#/$defs/Modality"
        }
      }
    },
    "ErrorEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "code",
        "message"
      ],
      "properties": {
        "type": {
          "const": "error",
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "fatal": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "ProactiveEvent": {
      "description": "Something the agent put on screen unprompted (reminder, ambient card). The accompanying spec ops and speech follow as normal events with the same turn_id.",
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "turn_id",
        "source",
        "title"
      ],
      "properties": {
        "type": {
          "const": "proactive",
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "reminder",
            "ambient",
            "runtime"
          ]
        },
        "title": {
          "type": "string"
        }
      }
    },
    "HeartbeatEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/Base"
        }
      ],
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "heartbeat",
          "type": "string"
        }
      }
    }
  }
}
