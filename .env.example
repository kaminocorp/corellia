# Committed template. Copy to backend/.env (gitignored). The Go binary
# auto-loads backend/.env from its working directory via godotenv/autoload;
# every variable is read in backend/internal/config and nowhere else.
# The client has no env file: it is served by the backend and reads runtime
# values from /api/config. In development the Vite dev server (:5173)
# proxies /api and /healthz to the backend (:8080).

# --- Server ---
PORT=8080
# Listen address. Empty: 127.0.0.1 in dev mode (no token), all interfaces
# when a token is set. Set explicitly to serve a box from a dev-mode
# machine (then the loopback-only rule still applies) or to pin a NIC.
CORELLIA_BIND=

# Bearer token the display box presents (header, or ?token= for the SSE
# stream). Leave empty for dev mode: loopback clients only, no credential.
# Generate one with: openssl rand -hex 32
CORELLIA_DEVICE_TOKEN=

# Proxies whose X-Forwarded-For / X-Real-IP are trusted (CIDRs or IPs,
# comma-separated). Empty: headers are ignored and the TCP peer is the
# client, which keeps dev mode's loopback rule honest.
CORELLIA_TRUSTED_PROXIES=

# Hosts the Image component may load from: exact names or *.suffix,
# comma-separated; `*` allows any https host. Enforced on Image ops and in
# the Content-Security-Policy the client is served with.
CORELLIA_IMAGE_HOSTS=upload.wikimedia.org,commons.wikimedia.org,images.unsplash.com

# IANA zone for reminders and the clock card (empty: the process zone,
# which follows the TZ environment variable; set one of them in Docker).
CORELLIA_TZ=

# Built client directory served with an SPA fallback (relative to the
# backend working directory). Build with `pnpm -C client build`.
CORELLIA_CLIENT_DIR=../client/dist

# Local state: transcript, memory, reminders.
CORELLIA_DATA_DIR=./data

# Product-facing agent name.
CORELLIA_AGENT_NAME=Corellia

# Extra CORS origins (comma-separated). Only needed when the client runs on
# another host during development; the Vite proxy makes it unnecessary.
CORELLIA_DEV_ORIGINS=http://localhost:5173

# --- Agent runtime (Phase 7) ---
# auto picks anthropic when ANTHROPIC_API_KEY is set, else openai when
# OPENAI_BASE_URL names an endpoint, else the keyless local runtime (a
# scripted demo; the header says "local demo"). OPENAI_API_KEY alone only
# enables voice: set CORELLIA_RUNTIME=openai to chat through OpenAI.
CORELLIA_RUNTIME=auto
# Claude via the Messages API (streaming, tool use, server-side refusal fallbacks).
ANTHROPIC_API_KEY=
# Model id for the cloud runtime (anthropic default claude-opus-5-5;
# openai default gpt-4o-mini, or deepseek-chat when the base URL is DeepSeek).
CORELLIA_MODEL=
# Thinking effort for the anthropic runtime: low (default, best latency), medium, high, xhigh, max.
CORELLIA_EFFORT=low
# Server-side refusal fallbacks (beta header) on every anthropic request.
# With a key: `scripts/anthropic-live-check.sh` runs a live check and the
# spike; its diagnosis names this setting when the beta is rejected.
# Set false if the account or API rejects the beta; every turn fails otherwise.
CORELLIA_ANTHROPIC_FALLBACKS=true
# Any OpenAI-shaped chat completions endpoint. DeepSeek models:
#   OPENAI_BASE_URL=https://api.deepseek.com/v1  OPENAI_API_KEY=<deepseek key>
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Hermes chat sidecar (adapters/hermes); CORELLIA_RUNTIME=hermes.
CORELLIA_HERMES_URL=
CORELLIA_HERMES_TOKEN=

# --- Voice (Phase 8) ---
# auto: openai when OPENAI_API_KEY is set (and OPENAI_BASE_URL is not DeepSeek), else none.
# none: the client uses the browser's SpeechRecognition and speechSynthesis (keyless dev path).
CORELLIA_STT=auto
CORELLIA_TTS=auto
# Provider voice name (OpenAI default alloy).
CORELLIA_TTS_VOICE=
# Mic activation: toggle (Ctrl+Space toggles an open, VAD-gated mic; off at boot) or ptt (hold Ctrl+Space).
CORELLIA_VOICE_MODE=toggle
# Barge-in: auto (speech while the agent talks stops playback and the turn) or
# off (speech detected while the agent is talking is ignored; typing and Escape
# still interrupt). Use off on laptop speakers, where the agent hears itself.
CORELLIA_VOICE_BARGE_IN=auto
