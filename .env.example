# Committed template. Copy to backend/.env (gitignored). The Go binary
# auto-loads backend/.env from its working directory via godotenv/autoload;
# every variable is read in backend/internal/config and nowhere else.
# The client has no env file: it is served by the backend and reads runtime
# values from /api/config. In development the Vite dev server (:5173)
# proxies /api and /healthz to the backend (:8080).

# --- Server ---
PORT=8080

# Bearer token the display box presents (header, or ?token= for the SSE
# stream). Leave empty for dev mode: loopback clients only, no credential.
# Generate one with: openssl rand -hex 32
CORELLIA_DEVICE_TOKEN=

# Built client directory served with an SPA fallback (relative to the
# backend working directory). Build with `pnpm -C client build`.
CORELLIA_CLIENT_DIR=../client/dist

# Local state: transcript, memory, reminders.
CORELLIA_DATA_DIR=./data

# Product-facing agent name.
CORELLIA_AGENT_NAME=Corellia

# Extra CORS origins (comma-separated). Only needed when the client runs on
# another host during development; the Vite proxy makes it unnecessary.
CORELLIA_DEV_ORIGINS=http://localhost:5173

# --- Later phases (documented here as they land) ---
# CORELLIA_RUNTIME=auto            # auto|local|anthropic|openai|hermes (Phase 7)
# ANTHROPIC_API_KEY=               # enables the anthropic runtime (Phase 7)
# OPENAI_API_KEY=                  # enables the openai-compatible runtime and voice provider (Phases 7, 8)
# OPENAI_BASE_URL=                 # e.g. https://api.deepseek.com for DeepSeek models (Phase 7)
