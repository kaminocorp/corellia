[Unit]
Description=Corellia display kiosk (X session + Chromium)
After=network-online.target systemd-user-sessions.service
Wants=network-online.target

[Service]
User=corellia
Group=corellia
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
Environment=HOME=/home/corellia
WorkingDirectory=/home/corellia
ExecStart=/usr/bin/startx /home/corellia/.xinitrc -- :0 vt1 -nocursor
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
